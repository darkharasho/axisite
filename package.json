{
  "name": "axisite",
  "version": "1.0.0",
  "description": "axisite is the front-page landing site for the axi suite of apps. It acts as a central hub linking out to every axi app and web property — including the ACRDPS wiki and the addon checker — with consistent branding from the shared axi-design style system. It lives alongside the other axi projects in Docs/Github.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-releases.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run --pool=forks --poolOptions.forks.maxForks=2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkharasho/axisite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/darkharasho/axisite/issues"
  },
  "homepage": "https://github.com/darkharasho/axisite#readme",
  "dependencies": {
    "astro": "^5.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
