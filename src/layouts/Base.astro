---
import { getCollection } from 'astro:content';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Every app and web property in the axi suite.' } = Astro.props;

const editorialPages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const navLinks = [
  { href: '/', label: 'The suite' },
  ...editorialPages.map((entry) => ({ href: `/${entry.id}`, label: entry.data.title })),
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const org = 'https://github.com/darkharasho';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="https://darkharasho.github.io/axi-design/v1/axi.css" />
  </head>
  <body>
    <header class="axi-mast">
      <div class="axi-mast__in">
        <a class="axi-brand" href="/">
          <span class="axi-sigil" aria-hidden="true">A</span>
          <span class="axi-brand__name">axi<small>The suite</small></span>
        </a>
        <nav class="axi-tabs">
          {navLinks.map((link) => {
            const linkPath = link.href.replace(/\/$/, '') || '/';
            const active = linkPath === currentPath;
            return (
              <a href={link.href} aria-current={active ? 'page' : undefined}>{link.label}</a>
            );
          })}
        </nav>
        <span class="site-mast__aside">
          <a class="axi-btn axi-btn--ghost" href={org}>GitHub</a>
        </span>
      </div>
    </header>

    <main class="axi-page">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="site-foot__in">
        <span class="site-foot__sig">
          <i aria-hidden="true"></i>
          Built by darkharasho for the WvW crowd.
        </span>
        <span class="site-foot__links">
          <a href={org}>GitHub</a>
          <a href="https://darkharasho.github.io/axi-design/">axi-design</a>
          {editorialPages.map((entry) => <a href={`/${entry.id}`}>{entry.data.title}</a>)}
        </span>
        <span class="site-foot__fine">
          Not affiliated with ArenaNet &middot; versions on this site refresh nightly from GitHub releases
        </span>
      </div>
    </footer>
  </body>
</html>
